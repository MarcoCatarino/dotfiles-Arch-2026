/* =============================================================================
   IMPORTACIÓN DINÁMICA DEL TEMA ENLAZADO POR ROFI
   ============================================================================= */
@import "current-theme.css";

/* =============================================================================
   DISEÑO ESTRUCTURAL BASE (Look de Islas)
   ============================================================================= */
* {
    background-color: transparent; /* Fondo general invisible para que las islas floten */
    font-family: "Iosevka Nerd Font Propo", monospace;
}

window#waybar {}

/* Contenedores de las Islas Flotantes */
.modules-left {
    background-color: @main-bg;
    border: 2px solid @main-brdr;
    border-radius: 16px;
    padding: 0px 8px;
    margin-top: 10px;
    margin-left: 10px;
}

.modules-center {
    background-color: @main-bg;
    border: 2px solid @main-brdr;
    border-radius: 16px;
    padding: 0px 10px;
    margin-top: 10px;
}

.modules-right {
    background-color: @main-bg;
    border: 2px solid @main-brdr;
    border-radius: 16px;
    padding: 0px 8px;
    margin-top: 10px;
    margin-right: 10px;
}

/* =============================================================================
   MÓDULOS INTERNOS (Márgenes y paddings de texto/iconos)
   ============================================================================= */
#pulseaudio,
#backlight,
#custom-weather,
#workspaces,
#disk,
#network,
#battery {
    padding: 0px 10px;
    margin: 0px 2px;
    border-radius: 6px;
}

#workspaces {
  min-width: 100px;
  font-size: 0.9rem;
  padding: 2px 4px;
  margin: 11px 0;
  border-radius: 99px;
}

#workspaces button {
  background-color: @main-bg;
  color: transparent;
  padding: 0px 5px;
  border-radius: 99px;
  margin: 0px 2px;
  min-width: 4px;
}

#workspaces button.active {
  background-color: @accent-workspace;
  min-width: 1.2rem;
  transition: none;
}


/* =============================================================================
   ASIGNACIÓN DE COLORES MEDIANTE VARIABLES NORMALIZADAS
   ============================================================================= */
#pulseaudio      { color: @accent-pulseaudio; }
#backlight       { color: @accent-backlight; }
#custom-weather  { color: @accent-weather; }
#disk            { color: @accent-disk; }
#network         { color: @accent-network; }
#battery         { color: @accent-battery; }

#network.disconnected {
    color: @accent-urgent;
}

#battery.charging {
    color: @accent-network;
}

#battery.warning {
    color: @accent-weather;
}

#battery.critical:not(.charging) {
    color: @accent-urgent;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: linear;
    animation-direction: alternate;
}

@keyframes blink {
    to {
        background-color: @accent-urgent;
        color: @main-bg;
    }
}

#cava {
    font-size: 1.1rem;      /* Controla la altura de los bloques de CAVA */
    padding: 0 10px;
    margin: 0px 2px;
    color: @accent-workspace; /* O el color que prefieras de tu current-theme.css */
}
