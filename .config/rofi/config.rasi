@import "current-theme.rasi"

/*****----- Configuration -----*****/
configuration {
    modi:                        "drun,window,Nvim:~/.config/rofi/scripts/nvim-selector.sh";
    show-icons:                  true;
    icon-theme:                  "Colloid";
    display-drun:                "APPS";
    display-window:              "WINDOW";
    display-run:                 "SHELL";
    drun-display-format:         "{name}";
    window-format:               "{w} · {t}";
}

/*****----- Global Properties -----*****/
* {
    font:                        "JetBrains Mono Nerd Font 10";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1000px;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    border-radius:               15px;
    cursor:                      "default";
    background-color:            var(background);
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 horizontal;
    children:                    [ "imagebox", "listbox" ];
}

imagebox {
    padding:                     20px;
    background-color:            transparent;
    background-image:            url("~/.config/rofi/themes/Zero-Two.jpeg", height);
    orientation:                 vertical;
    children:                    [ "inputbar", "dummy", "mode-switcher" ];
}

listbox {
    spacing:                     20px;
    padding:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

dummy {
    background-color:            transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    spacing:                     10px;
    padding:                     15px;
    border-radius:               10px;
    background-color:            var(background-alt);
    text-color:                  var(foreground);
    children:                    [ "textbox-prompt-colon", "entry" ];
}
textbox-prompt-colon {
    expand:                      false;
    str:                         "  ";
    background-color:            inherit;
    text-color:                  inherit;
}
entry {
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           inherit;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    spacing:                     20px;
    background-color:            transparent;
    text-color:                  var(foreground);
}
button {
    padding:                     15px;
    border-radius:               10px;
    background-color:            var(background-alt);
    text-color:                  inherit;
    cursor:                      pointer;
}
button selected {
    background-color:            var(selected);
    text-color:                  var(background);
}

/*****----- Listview -----*****/
listview {
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  var(foreground);
}

/*****----- Elements -----*****/
element {
    spacing:                     15px;
    padding:                     8px;
    border-radius:               10px;
    text-color:                  var(foreground);
    cursor:                      pointer;
}

element normal.normal,
element alternate.normal {
    background-color:            transparent;
    text-color:                  var(foreground);
}

element selected.normal {
    background-color:            var(background-alt);
    text-color:                  var(foreground);
    border-radius:               10px;
    border-color:                var(selected);
}
element-icon {
    size:                        32px;
    background-color:            transparent;
}
element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    background-color:            transparent;
    text-color:                  inherit;
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
}
textbox {
    padding:                     15px;
    border-radius:               10px;
    background-color:            var(background-alt);
    text-color:                  var(foreground);
}
error-message {
    padding:                     15px;
    border-radius:               20px;
    background-color:            var(background);
    text-color:                  var(foreground);
}
