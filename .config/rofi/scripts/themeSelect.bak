#!/usr/bin/env bash

rofi_colors="$HOME/.config/rofi/colors"
current_theme="$HOME/.config/rofi/current-theme.rasi"

# Use rofi style as selector theme
rofi_config="$HOME/.config/rofi/config.rasi"

# List .ras styles 
menu() {
    options=()
    while IFS= read -r file; do
        if [ -f "$rofi_colors/$file" ]; then
            options+=("$(basename "$file" .rasi)")
        fi
    done < <(find "$rofi_colors" -maxdepth 1 -type f -name '*.rasi' -exec basename {} \; | sort)
    
    printf '%s\n' "${options[@]}"
}

# Applied styles
apply_theme() {
    ln -sf "$rofi_colors/$1.rasi" "$current_theme"
}

# Main Function
main() {
    choice=$(menu | rofi -dmenu -config "$rofi_config" -p "Themes")

    if [[ -z "$choice" ]]; then
        echo "No se seleccionó ningún tema. Saliendo."
        exit 0
    fi

    apply_theme "$choice"
}

# Avoid duplicates of Rofi
if pgrep -x "rofi" >/dev/null; then
    pkill rofi
    exit 0
fi

main